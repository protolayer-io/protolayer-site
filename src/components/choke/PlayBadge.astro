---
// Official Google Play badge, self-hosted per locale (en / es-419 / pt-br).
// The artwork must not be recoloured or cropped — Google's brand guidelines
// bake the required clear space into the PNG, so the only knob is height.
// `dark` (hero) sits on the page background, `ink` (CTA banner) sits on the
// green gradient; both work because the badge is black with a light outline.
import { PLAY_URL } from './config';
import { getChoke, type Lang } from '../../i18n/ui';
import { defaultLang } from '../../i18n/utils';

interface Props {
  variant?: 'dark' | 'ink';
  lang?: Lang;
}

const { variant = 'dark', lang = defaultLang } = Astro.props;
const getItOn = getChoke(lang).getItOn;
const src = `/choke/google-play-badge-${lang}.png`;
// The hero badge is above the fold; the CTA one is at the bottom of the page.
const loading = variant === 'dark' ? 'eager' : 'lazy';
---

<a class:list={['badge', variant]} href={PLAY_URL} target="_blank" rel="noopener">
  <img src={src} alt={`${getItOn} Google Play`} width="646" height="250" loading={loading} />
</a>

<style>
  .badge {
    display: inline-flex;
    transition: transform 0.15s ease;
  }

  .badge:hover {
    transform: translateY(-1px);
  }

  .badge img {
    display: block;
    width: auto;
  }

  /* Heights include the badge's built-in clear space, so the visible artwork
     lands comfortably above Google's 40px minimum. */
  .dark img {
    height: 60px;
  }

  .ink img {
    height: 64px;
  }
</style>
