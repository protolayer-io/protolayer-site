---
import PlayBadge from './PlayBadge.astro';
import DesktopBadges from './DesktopBadges.astro';
import { LIVE_URL } from './config';
import { getChoke, type Lang } from '../../i18n/ui';
import { defaultLang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = getChoke(lang).hero;
---

<header class="hero container">
  <div class="copy">
    <div class="live-badge">
      <span class="dot"></span>
      {t.badge}
    </div>
    <h1 set:html={t.titleHtml} />
    <p class="lead">{t.lead}</p>
    <div class="actions">
      <PlayBadge lang={lang} />
      <a class="watch" href={LIVE_URL} target="_blank" rel="noopener">
        {t.watch}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            stroke="#22C55E"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
    <DesktopBadges lang={lang} />
    <div class="checks">
      <span><b>✓</b> {t.check1}</span>
      <span><b>✓</b> {t.check2}</span>
      <span><b>✓</b> {t.check3}</span>
    </div>
  </div>

  <div class="visual">
    <div class="device">
      <span class="camera"></span>
      <div class="screen">
        <img
          src="/choke/screen-scoring.jpg"
          alt="Choke live scoring screen on a phone held in landscape"
          loading="eager"
        />
      </div>
      <span class="home-bar"></span>
    </div>
    <div class="phone">
      <img src="/choke/screen-home.jpg" alt="Choke match list" loading="eager" />
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 90px;
  }

  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--green);
    background: rgba(27, 163, 78, 0.12);
    border: 1px solid rgba(27, 163, 78, 0.3);
    padding: 7px 13px;
    border-radius: 100px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse-dot 1.6s infinite;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(42px, 5.5vw, 66px);
    line-height: 1.02;
    letter-spacing: -2px;
    margin-top: 22px;
  }

  h1 :global(.accent) {
    color: var(--green);
  }

  .lead {
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 520px;
    margin-top: 24px;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 34px;
    flex-wrap: wrap;
  }

  .watch {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    font-weight: 700;
    font-size: 16px;
    padding: 14px 8px;
  }

  .watch:hover {
    color: var(--green-light);
  }

  .checks {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 38px;
    font-size: 14px;
    color: var(--muted-2);
    font-weight: 600;
    flex-wrap: wrap;
  }

  .checks span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .checks b {
    color: var(--green);
  }

  .visual {
    position: relative;
    height: 520px;
  }

  /* Phone held in landscape: thicker left/right bezels hold the camera and
     the home bar, the same way the device sits when scoring a match. */
  .device {
    position: absolute;
    top: 34px;
    right: 0;
    width: 560px;
    max-width: 100%;
    border-radius: 38px;
    padding: 13px 26px;
    background: linear-gradient(150deg, #2b2b30, #0e0e10 45%, #26262b);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      0 40px 90px rgba(0, 0, 0, 0.6),
      inset 0 0 0 2px rgba(0, 0, 0, 0.7);
  }

  .screen {
    border-radius: 18px;
    overflow: hidden;
    background: #000;
  }

  .device img {
    display: block;
    width: 100%;
  }

  .camera {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #08080a;
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.18);
  }

  .home-bar {
    position: absolute;
    right: 11px;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 78px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.45);
  }

  .phone {
    position: absolute;
    bottom: -30px;
    left: -8px;
    width: 172px;
    border-radius: 26px;
    padding: 7px;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.65);
    animation: floaty 6s ease-in-out infinite;
  }

  .phone img {
    display: block;
    width: 100%;
    border-radius: 20px;
  }

  @media (max-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-bottom: 70px;
    }

    .visual {
      height: auto;
      max-width: 640px;
      min-width: 0;
    }

    .device {
      position: relative;
      top: 0;
      width: 100%;
    }

    .phone {
      bottom: -24px;
    }
  }

  @media (max-width: 720px) {
    .phone {
      display: none;
    }
  }
</style>
