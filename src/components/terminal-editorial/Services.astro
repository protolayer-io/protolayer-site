---
// Design 1a — four services as emerald top-border columns.
import { getSite, type Lang } from '../../i18n/ui';
import { defaultLang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const site = getSite(lang);
const services = site.services;
---

<section class="services">
  <div class="container">
    <p class="mono-label label" data-reveal>{site.te.servicesLabel}</p>
    <div class="grid">
      {
        services.map((service) => (
          <div class="item" data-reveal>
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding: 26px var(--page-pad) 60px;
  }

  .label {
    color: var(--muted-2);
    margin-bottom: 22px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .item {
    border-top: 2px solid var(--brand);
    padding-top: 16px;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: var(--text);
    margin-bottom: 8px;
  }

  p {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
