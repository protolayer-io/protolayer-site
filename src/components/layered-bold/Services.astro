---
// Design 1b — four numbered service cards with hover-lift on a raised strip.
import { getSite, type Lang } from '../../i18n/ui';
import { defaultLang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const services = getSite(lang).services.map((service, i) => ({
  number: String(i + 1).padStart(2, '0'),
  ...service,
}));
---

<section class="services">
  <div class="grid container">
    {
      services.map((service) => (
        <div class="card item" data-reveal>
          <div class="number">{service.number}</div>
          <h3>{service.title}</h3>
          <p>{service.copy}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .services {
    padding: 56px var(--page-pad);
    background: var(--surface-2);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .item {
    padding: 24px;
    cursor: default;
  }

  .number {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--brand-2);
    margin-bottom: 14px;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    color: var(--text);
    margin-bottom: 8px;
  }

  p {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
